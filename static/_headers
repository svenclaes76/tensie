# Response headers for Cloudflare Pages and Netlify (both read this file from the site root).
# The Content Security Policy itself is a <meta> tag that SvelteKit writes with script hashes
# (vite.config.ts); frame-ancestors only works as a header, so it is added here.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow

# Hashed file names never change content: cache for a year.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Always fetch these fresh, so a new version is found and "Update beschikbaar" can appear (N1).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
