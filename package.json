		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.2",
		"@vite-pwa/assets-generator": "^2.0.0",
		"fake-indexeddb": "^6.2.6",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^4.1.8",
